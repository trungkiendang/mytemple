# Copy to .github/store.env (gitignored), fill in the values, then run:
#   scripts/setup_github_secrets.sh            (needs the GitHub CLI `gh`, logged in)
# A value written as @path/to/file is replaced by that file's contents (for .json / .p8).
# Names starting with SECRET_ become repository *secrets*, VAR_ become repository *variables*.
# Full explanation of every item: docs/STORE_PUBLISHING.md

# ── Android / Google Play ─────────────────────────────
SECRET_ANDROID_KEYSTORE_BASE64=       # base64 -w0 upload-keystore.jks
SECRET_ANDROID_KEYSTORE_PASSWORD=
SECRET_ANDROID_KEY_ALIAS=
SECRET_ANDROID_KEY_PASSWORD=
SECRET_PLAY_SERVICE_ACCOUNT_JSON=     # @/path/to/service-account.json (Play Console → API access)
VAR_PLAY_DEFAULT_TRACK=internal       # internal | alpha | beta | production
VAR_PLAY_RELEASE_STATUS=draft         # draft until the first manual release exists

# ── iOS / TestFlight ──────────────────────────────────
SECRET_IOS_DIST_CERT_BASE64=          # base64 -i Distribution.p12
SECRET_IOS_DIST_CERT_PASSWORD=
SECRET_IOS_PROVISION_PROFILE_BASE64=  # base64 -i MyChua_AppStore.mobileprovision
SECRET_ASC_KEY_ID=                    # App Store Connect API key id
SECRET_ASC_ISSUER_ID=
SECRET_ASC_API_KEY_P8=                # @/path/to/AuthKey_XXXX.p8
VAR_APPLE_TEAM_ID=
VAR_IOS_PROVISION_PROFILE_NAME=       # profile name exactly as in the developer portal
VAR_IOS_BUNDLE_ID=com.kun.temple
